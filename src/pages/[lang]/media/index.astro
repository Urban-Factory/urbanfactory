---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { published, useTranslations, type Lang } from '../../../i18n/ui';
import { localePath } from '../../../lib/site';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const items = (await getCollection('media', (m) => m.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
---

<Base lang={lang} title={`${t('media.title')} — Urban Factory`} description={t('media.meta.description')}>
  <PageHeader title={t('media.title')} lead={t('media.lead')} />

  <section class="wrap pb-section">
    <ul class="grid gap-16 md:grid-cols-2 md:gap-x-8">
      {
        items.map((m, i) => (
          <li>
            <article class="group relative flex flex-col">
              <div class="aspect-[4/3] overflow-hidden bg-surface">
                {m.data.cover && (
                  <Image
                    src={m.data.cover}
                    alt={m.data.coverAlt ?? ''}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
                  />
                )}
              </div>
              <p class="mt-5 eyebrow text-red">{m.data.date} · {m.data.place}</p>
              <h2 class="mt-3 text-3xl leading-[1.05] md:text-4xl">
                <a href={localePath(lang, `/media/${m.data.slug}/`)} class="after:absolute after:inset-0 after:content-['']">
                  {m.data.title}
                </a>
              </h2>
              <p class="mt-3 max-w-prose text-ink/85">{m.data.summary}</p>
              <span class="link-arrow mt-5 text-sm" aria-hidden="true">{t('media.read')}</span>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <CtaBand lang={lang} />
</Base>
