---
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CtaBand from '../../../components/CtaBand.astro';
import LiteYouTube from '../../../components/LiteYouTube.astro';
import MediaCard, { type CardData } from '../../../components/MediaCard.astro';
import { languages, published, useTranslations, type Lang } from '../../../i18n/ui';
import { localePath } from '../../../lib/site';
import { getProjects } from '../../../lib/projects';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const sections = ['interviews', 'articles', 'talks', 'press'] as const;

/**
 * Ключ сортировки: новые сверху. Неточная дата (только год или год-месяц)
 * дополняется нулями — такая запись встаёт в конец своего года/месяца.
 */
const sortKey = (d: string) => (d + '-00-00').slice(0, 10);
const entries = (await getCollection('media', (m) => m.data.lang === lang)).sort((a, b) =>
  sortKey(b.data.date).localeCompare(sortKey(a.data.date)),
);
// Видео не переводим: ролики показываем только в версии сайта на языке ролика
const seriesBySlug = new Map(
  (await getProjects(lang)).map((p) => [p.data.slug, p.data.youtubeAllLangs ? p.data.youtube : p.data.youtube.filter((v) => v.lang === lang)]),
);
const showVideo = (e: CollectionEntry<'media'>) => Boolean(e.data.video) && (e.data.allLangs || e.data.originalLang === lang);
// Закреплённые записи (поле pin): сверху страницы по возрастанию pin, первая — во всю ширину; в своих разделах не повторяются
const pinned = entries.filter((e) => e.data.pin !== undefined).sort((a, b) => a.data.pin! - b.data.pin!);
// Записи раздела, которые видны в этой языковой версии (без закреплённых)
const sectionList = (s: (typeof sections)[number]) =>
  entries.filter(
    (e) =>
      e.data.section === s &&
      e.data.pin === undefined &&
      !(e.data.series && (seriesBySlug.get(e.data.series) ?? []).length === 0) &&
      !(e.data.video && !e.data.url && !e.data.interview && !showVideo(e)),
  );
// Навигация: раздел со своими записями → #раздел; раздел, где видна только закреплённая запись → #pinned
const sectionNav = sections
  .map((s) => ({ s, href: sectionList(s).length > 0 ? `#${s}` : pinned.some((e) => e.data.section === s) ? '#pinned' : undefined }))
  .filter((n) => n.href !== undefined);
const interviews = new Map(
  (await getCollection('interviews', (m) => m.data.lang === lang)).map((i) => [i.data.slug, i]),
);

/** 2014-02-24 → 24 Feb 2014; 2018 → 2018 */
function formatDate(d: string) {
  const [y, m, day] = d.split('-').map(Number);
  if (!m) return String(y);
  const opts: Intl.DateTimeFormatOptions = day ? { day: 'numeric', month: 'long', year: 'numeric' } : { month: 'long', year: 'numeric' };
  return new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : languages[lang].htmlLang, opts).format(new Date(Date.UTC(y, m - 1, day || 1)));
}

/** Данные для крупной карточки интервью: из страницы интервью, если она есть, иначе из записи. */
function card(e: CollectionEntry<'media'>): CardData {
  const iv = e.data.interview ? interviews.get(e.data.interview) : undefined;
  return {
    title: iv?.data.title ?? e.data.title,
    summary: iv?.data.summary,
    meta: iv ? `${iv.data.date} · ${iv.data.place}` : formatDate(e.data.date),
    cover: iv?.data.cover,
    coverAlt: iv?.data.coverAlt ?? '',
    href: iv ? localePath(lang, `/media/${iv.data.slug}/`) : e.data.video ? `https://www.youtube.com/watch?v=${e.data.video}` : e.data.url,
    internal: Boolean(iv),
    video: iv || !showVideo(e) ? undefined : e.data.video,
  };
}
---

<Base lang={lang} title={`${t('media.title')} — Urban Factory`} description={t('media.meta.description')}>
  <PageHeader title={t('media.title')} lead={t('media.lead')}>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      {
        sectionNav.map((n) => (
          <li>
            <a href={n.href} class="link-arrow text-sm">{t(`media.section.${n.s}`)}</a>
          </li>
        ))
      }
    </ul>
  </PageHeader>

  <div class="wrap space-y-20 pb-section md:space-y-28">
    {
      pinned.length > 0 && (
        <section id="pinned" class="scroll-mt-24" aria-label={t('media.pinned')}>
          <ul class="grid gap-14 md:grid-cols-2 md:gap-x-8">
            {pinned.map((e, i) => (
              <li class:list={[i === 0 && 'md:col-span-2']}>
                <MediaCard entry={e} card={card(e)} lang={lang} eager large={i === 0} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
    {
      sections.map((s) => {
        const list = sectionList(s);
        if (list.length === 0) return null;
        return (
          <section id={s} class="scroll-mt-24" aria-labelledby={`${s}-title`}>
            <h2 id={`${s}-title`} class="border-t-4 border-ink pt-6 text-h2">{t(`media.section.${s}`)}</h2>

            {s === 'interviews' ? (
              <ul class="mt-10 grid gap-14 md:grid-cols-2 md:gap-x-8">
                {list.map((e, i) => {
                  const series = e.data.series ? seriesBySlug.get(e.data.series) ?? [] : [];
                  if (series.length > 0)
                    return (
                      <li class="md:col-span-2">
                        <div class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
                          <h3 class="text-2xl leading-[1.05] md:text-3xl">{e.data.title}</h3>
                          <p class="text-sm text-ink/80">
                            {e.data.outlet}
                            <span class="mx-2 inline-block border border-ink/30 px-1.5 text-xs leading-5 font-semibold">{t(`media.lang.${e.data.originalLang}`)}</span>
                            {e.data.role}
                          </p>
                        </div>
                        <ol class="mt-6 grid gap-x-6 gap-y-8 sm:grid-cols-2 lg:grid-cols-4">
                          {series.map((v, n) => (
                            <li>
                              <LiteYouTube id={v.id} title={`${n + 1}. ${v.title}`} lang={lang} videoLang={v.lang} recorded={v.recorded} published={v.published} />
                            </li>
                          ))}
                        </ol>
                        {e.data.seeAlso && (
                          <a href={localePath(lang, `/projects/${e.data.seeAlso.project}/`)} class="link-arrow mt-6 text-sm font-bold text-red-text">
                            {e.data.seeAlso.label}
                          </a>
                        )}
                      </li>
                    );
                  return (
                    <li>
                      <MediaCard entry={e} card={card(e)} lang={lang} eager={i < 3} />
                    </li>
                  );
                })}
              </ul>
            ) : (
              <ul class="mt-6 divide-y divide-line border-b border-line">
                {list.map((e) => (
                  <li class="grid gap-2 py-6 md:grid-cols-12 md:gap-8">
                    <span class="text-sm text-muted md:col-span-2 md:pt-1">{formatDate(e.data.date)}</span>
                    <div class="md:col-span-8">
                      <h3 class="font-display text-xl leading-tight font-bold normal-case md:text-2xl">
                        {e.data.url ? (
                          <a href={e.data.url} target="_blank" rel="noopener" class="hover:text-red-text">
                            {e.data.title}
                            <span class="sr-only"> ({t('media.newWindow')})</span>
                          </a>
                        ) : (
                          e.data.title
                        )}
                      </h3>
                      {e.data.description && <p class="mt-2 max-w-prose text-ink/85">{e.data.description}</p>}
                      <p class="mt-2 text-sm text-ink/80">
                        {e.data.outlet}
                        <span class="mx-2 inline-block border border-ink/30 px-1.5 text-xs leading-5 font-semibold">{t(`media.lang.${e.data.originalLang}`)}</span>
                        {e.data.role}
                      </p>
                      {e.data.archive && (
                        <p class="mt-2 text-sm">
                          <a href={e.data.archive} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-red-text">
                            {t('media.archive')} ↗<span class="sr-only"> ({t('media.newWindow')})</span>
                          </a>
                        </p>
                      )}
                    </div>
                    {e.data.url && (
                      <span class="text-sm md:col-span-2 md:pt-1 md:text-right" aria-hidden="true">{t('media.original')} ↗</span>
                    )}
                    {showVideo(e) && (
                      <div class="md:col-span-6 md:col-start-3">
                        <LiteYouTube id={e.data.video!} title={e.data.title} lang={lang} class="[&_figcaption]:hidden" />
                      </div>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })
    }
  </div>

  <CtaBand lang={lang} />
</Base>
