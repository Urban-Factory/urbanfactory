---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHeader from '../../../components/PageHeader.astro';
import CtaBand from '../../../components/CtaBand.astro';
import Logo from '../../../components/Logo.astro';
import LiteYouTube from '../../../components/LiteYouTube.astro';
import { languages, published, useTranslations, type Lang } from '../../../i18n/ui';
import { localePath } from '../../../lib/site';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const sections = ['interviews', 'articles', 'talks', 'press'] as const;

/**
 * Ключ сортировки: новые сверху. Неточная дата (только год или год-месяц)
 * дополняется нулями — такая запись встаёт в конец своего года/месяца.
 */
const sortKey = (d: string) => (d + '-00-00').slice(0, 10);
const entries = (await getCollection('media', (m) => m.data.lang === lang)).sort((a, b) =>
  sortKey(b.data.date).localeCompare(sortKey(a.data.date)),
);
const interviews = new Map(
  (await getCollection('interviews', (m) => m.data.lang === lang)).map((i) => [i.data.slug, i]),
);

/** 2014-02-24 → 24 Feb 2014; 2018 → 2018 */
function formatDate(d: string) {
  const [y, m, day] = d.split('-').map(Number);
  if (!m) return String(y);
  const opts: Intl.DateTimeFormatOptions = day ? { day: 'numeric', month: 'long', year: 'numeric' } : { month: 'long', year: 'numeric' };
  return new Intl.DateTimeFormat(lang === 'en' ? 'en-GB' : languages[lang].htmlLang, opts).format(new Date(Date.UTC(y, m - 1, day || 1)));
}

/** Данные для крупной карточки интервью: из страницы интервью, если она есть, иначе из записи. */
function card(e: CollectionEntry<'media'>) {
  const iv = e.data.interview ? interviews.get(e.data.interview) : undefined;
  return {
    title: iv?.data.title ?? e.data.title,
    summary: iv?.data.summary,
    meta: iv ? `${iv.data.date} · ${iv.data.place}` : formatDate(e.data.date),
    cover: iv?.data.cover,
    coverAlt: iv?.data.coverAlt ?? '',
    href: iv ? localePath(lang, `/media/${iv.data.slug}/`) : e.data.video ? `https://www.youtube.com/watch?v=${e.data.video}` : e.data.url,
    internal: Boolean(iv),
    video: iv ? undefined : e.data.video,
  };
}
---

<Base lang={lang} title={`${t('media.title')} — Urban Factory`} description={t('media.meta.description')}>
  <PageHeader title={t('media.title')} lead={t('media.lead')}>
    <ul class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      {
        sections.map((s) => (
          <li>
            <a href={`#${s}`} class="link-arrow text-sm">{t(`media.section.${s}`)}</a>
          </li>
        ))
      }
    </ul>
  </PageHeader>

  <div class="wrap space-y-20 pb-section md:space-y-28">
    {
      sections.map((s) => {
        const list = entries.filter((e) => e.data.section === s);
        if (list.length === 0) return null;
        return (
          <section id={s} class="scroll-mt-24" aria-labelledby={`${s}-title`}>
            <h2 id={`${s}-title`} class="border-t-4 border-ink pt-6 text-h2">{t(`media.section.${s}`)}</h2>

            {s === 'interviews' ? (
              <ul class="mt-10 grid gap-14 md:grid-cols-2 md:gap-x-8 lg:grid-cols-3">
                {list.map((e, i) => {
                  const c = card(e);
                  return (
                    <li>
                      <article class="group relative flex h-full flex-col">
                        {c.video ? (
                          <LiteYouTube id={c.video} title={c.title} lang={lang} videoLang={e.data.originalLang === 'pt' ? undefined : e.data.originalLang} class="relative z-10 [&_a]:aspect-[4/3] [&_figcaption]:hidden" />
                        ) : (
                        <div class="aspect-[4/3] overflow-hidden bg-surface">
                          {c.cover ? (
                            <Image
                              src={c.cover}
                              alt={c.coverAlt}
                              widths={[480, 800, 1200]}
                              sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                              loading={i < 3 ? 'eager' : 'lazy'}
                              class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
                            />
                          ) : (
                            <div class="flex h-full items-center justify-center text-ink/10">
                              <Logo variant="mark" class="h-1/2" />
                            </div>
                          )}
                        </div>
                        )}
                        <p class="mt-5 eyebrow text-red">{c.meta}</p>
                        <h3 class="mt-3 text-2xl leading-[1.05] md:text-3xl">
                          {c.href ? (
                            <a
                              href={c.href}
                              target={c.internal ? undefined : '_blank'}
                              rel={c.internal ? undefined : 'noopener'}
                              class="after:absolute after:inset-0 after:content-['']"
                            >
                              {c.title}
                              {!c.internal && <span class="sr-only"> ({t('media.newWindow')})</span>}
                            </a>
                          ) : (
                            c.title
                          )}
                        </h3>
                        {c.summary && <p class="mt-3 max-w-prose text-ink/85">{c.summary}</p>}
                        <p class="mt-4 text-sm text-ink/80">
                          {e.data.outlet}
                          <span class="mx-2 inline-block border border-ink/30 px-1.5 text-xs leading-5 font-semibold">{t(`media.lang.${e.data.originalLang}`)}</span>
                          {e.data.role}
                        </p>
                        <div class="relative z-10 mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-5 text-sm">
                          {c.internal && <span class="link-arrow" aria-hidden="true">{t('media.read')}</span>}
                          {c.video && <span class="link-arrow" aria-hidden="true">{t('media.watch')}</span>}
                          {e.data.url && (
                            <a href={e.data.url} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-red">
                              {e.data.urlLabel ?? t('media.original')} ↗<span class="sr-only"> ({t('media.newWindow')})</span>
                            </a>
                          )}
                        </div>
                        {e.data.seeAlso && (
                          <a href={localePath(lang, `/projects/${e.data.seeAlso.project}/`)} class="link-arrow relative z-10 mt-3 text-sm font-bold text-red">
                            {e.data.seeAlso.label}
                          </a>
                        )}
                      </article>
                    </li>
                  );
                })}
              </ul>
            ) : (
              <ul class="mt-6 divide-y divide-line border-b border-line">
                {list.map((e) => (
                  <li class="grid gap-2 py-6 md:grid-cols-12 md:gap-8">
                    <span class="text-sm text-muted md:col-span-2 md:pt-1">{formatDate(e.data.date)}</span>
                    <div class="md:col-span-8">
                      <h3 class="font-display text-xl leading-tight font-bold normal-case md:text-2xl">
                        {e.data.url ? (
                          <a href={e.data.url} target="_blank" rel="noopener" class="hover:text-red">
                            {e.data.title}
                            <span class="sr-only"> ({t('media.newWindow')})</span>
                          </a>
                        ) : (
                          e.data.title
                        )}
                      </h3>
                      <p class="mt-2 text-sm text-ink/80">
                        {e.data.outlet}
                        <span class="mx-2 inline-block border border-ink/30 px-1.5 text-xs leading-5 font-semibold">{t(`media.lang.${e.data.originalLang}`)}</span>
                        {e.data.role}
                      </p>
                    </div>
                    {e.data.url && (
                      <span class="text-sm md:col-span-2 md:pt-1 md:text-right" aria-hidden="true">{t('media.original')} ↗</span>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </section>
        );
      })
    }
  </div>

  <CtaBand lang={lang} />
</Base>
