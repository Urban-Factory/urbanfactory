---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import { Picture } from 'astro:assets';
import portrait from '../../assets/team/mihail-veklenko.png';
import { published, useTranslations, type Lang } from '../../i18n/ui';
import { getCopy } from '../../i18n/copy';
import { byRecency, formatYears, getProjects } from '../../lib/projects';
import { localePath } from '../../lib/site';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = getCopy(lang).team;
const f = c.founder;
const projects = await getProjects(lang);
const bySlug = new Map(projects.map((p) => [p.data.slug, p]));
const led = f.projects.map((s) => bySlug.get(s)).filter((p) => p !== undefined).sort(byRecency);
const groups = c.past
  .filter((g) => g.teamPage !== false && bySlug.has(g.project))
  .sort((a, b) => byRecency(bySlug.get(a.project)!, bySlug.get(b.project)!));
---

<Base lang={lang} title={`${c.title} — Urban Factory`} description={t('team.meta.description')}>
  <PageHeader title={c.title} lead={c.lead} />

  <!-- Основатель -->
  <section class="wrap pb-section">
    <article class="grid gap-10 md:grid-cols-12 md:gap-12">
      <div class="self-start md:sticky md:top-28 md:col-span-5 lg:col-span-4">
        <!-- Фото с прозрачным фоном; фон — токен surface -->
        <Picture
          src={portrait}
          alt={`${t('team.photo')} ${f.name}`}
          formats={['avif', 'webp']}
          widths={[320, 480, 640, 960, 1200]}
          sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 100vw"
          loading="eager"
          class="aspect-square w-full bg-surface object-cover"
        />
      </div>
      <div class="md:col-span-7 lg:col-span-7 lg:col-start-6">
        <p class="eyebrow text-red-text">{f.role}</p>
        <h2 class="mt-3 text-h1">{f.name}</h2>
        <div class="mt-8 space-y-4 text-lead text-ink/85">
          {f.bio.map((p) => <p>{p}</p>)}
        </div>

        <div class="mt-12 grid gap-10 sm:grid-cols-2">
          <div class="sm:col-span-2">
            <h3 class="eyebrow text-muted">{t('team.education')}</h3>
            <ul class="mt-5 divide-y divide-line border-y border-line">
              {f.education.map((e) => <li class="py-3">{e}</li>)}
            </ul>
          </div>
          <div class="sm:col-span-2">
            <h3 class="eyebrow text-muted">{t('team.experience')}</h3>
            <ul class="mt-5 divide-y divide-line border-y border-line">
              {f.experience.map((e) => <li class="py-3">{e}</li>)}
            </ul>
          </div>
          <div>
            <h3 class="eyebrow text-muted">{t('team.expertise')}</h3>
            <ul class="mt-5 space-y-3">
              {
                f.expertise.map((e) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 h-2 w-2 shrink-0 bg-red" aria-hidden="true" />
                    <span>{e}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <h3 class="eyebrow text-muted">{t('team.projectsLed')}</h3>
            <ul class="mt-5 divide-y divide-line border-y border-line">
              {
                led.map((p) => (
                  <li>
                    <a href={localePath(lang, `/projects/${p.data.slug}/`)} class="group flex items-baseline justify-between gap-4 py-3">
                      <span class="font-display font-semibold uppercase group-hover:text-red-text">{p.data.title.split(':')[0]}</span>
                      <span class="shrink-0 text-sm text-muted">{formatYears(p.data.year, t('project.present'))}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </article>
  </section>

  <!-- Участники прошлых проектов -->
  <section class="bg-surface py-section" aria-labelledby="past-title">
    <div class="wrap">
      <h2 id="past-title" class="text-h2">{c.pastTitle}</h2>
      <p class="mt-4 max-w-2xl text-lead text-ink/85">{c.pastText}</p>
      <div class="mt-12 divide-y divide-line border-y border-line">
        {
          groups.map((group) => {
            const p = bySlug.get(group.project);
            return p ? (
              <section class="grid gap-4 py-8 md:grid-cols-12 md:gap-8">
                <h3 class="text-xl md:col-span-4">
                  <a href={localePath(lang, `/projects/${group.project}/`)} class="underline-offset-4 hover:text-red-text hover:underline">{p.data.title.split(':')[0]}</a>
                  <span class="mt-1 block font-sans text-sm font-normal tracking-normal text-muted normal-case">{formatYears(p.data.year, t('project.present'))}</span>
                </h3>
                <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2 md:col-span-8 lg:grid-cols-3">
                  {group.people.map((person) => (
                    <li>
                      <span class="block font-display font-bold uppercase">{person.name}</span>
                      <span class="block text-sm text-ink/80">{person.role}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ) : null;
          })
        }
      </div>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
