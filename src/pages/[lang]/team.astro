---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Logo from '../../components/Logo.astro';
import { published, useTranslations, type Lang } from '../../i18n/ui';
import { getCopy } from '../../i18n/copy';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = getCopy(lang).team;
const initials = c.founder.name
  .split(' ')
  .map((w) => w[0])
  .join('');
---

<Base lang={lang} title={`${c.title} — Urban Factory`} description={t('team.meta.description')}>
  <PageHeader title={c.title} lead={c.lead} />

  <section class="wrap pb-section">
    <article class="grid gap-10 md:grid-cols-12 md:gap-12">
      <!-- Фото основателя пока нет — карточка с инициалами -->
      <div class="relative aspect-[4/5] bg-ink text-paper md:col-span-5 lg:col-span-4" role="img" aria-label={`${t('team.photo')} ${c.founder.name}`}>
        <span class="absolute bottom-6 left-6 font-display text-[clamp(4rem,10vw,8rem)] leading-none font-bold" aria-hidden="true">{initials}</span>
        <Logo variant="mark" class="absolute top-6 right-6 h-14 text-red" />
      </div>
      <div class="md:col-span-7 lg:col-span-6 lg:col-start-6">
        <p class="eyebrow text-red">{c.founder.role}</p>
        <h2 class="mt-3 text-h2">{c.founder.name}</h2>
        <div class="mt-6 space-y-4 text-lead text-ink/85">
          {c.founder.bio.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </article>
  </section>

  <section class="bg-surface py-section" aria-labelledby="network-title">
    <div class="wrap grid gap-8 lg:grid-cols-12">
      <h2 id="network-title" class="text-h2 lg:col-span-5">{c.networkTitle}</h2>
      <p class="text-lead text-ink/85 lg:col-span-6 lg:col-start-7">{c.networkText}</p>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
