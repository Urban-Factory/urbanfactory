---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import Protected from '../../components/Protected.astro';
import NoJsContact from '../../components/NoJsContact.astro';
import RevealPhone from '../../components/RevealPhone.astro';
import { published, useTranslations, type Lang } from '../../i18n/ui';
import { getCopy } from '../../i18n/copy';
import { contacts } from '../../lib/site';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = getCopy(lang).contact;
const secondary =
  'inline-flex min-h-12 items-center gap-2 border-2 border-ink px-5 font-display font-semibold tracking-[0.08em] uppercase transition-colors hover:bg-ink hover:text-paper';
---

<Base lang={lang} title={`${c.title} — Urban Factory`} description={t('contact.meta.description')}>
  <PageHeader title={c.title} lead={c.lead} />

  <section class="wrap pb-section">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <!-- Главный канал — email -->
        <p class="eyebrow text-muted">{t('contact.email')}</p>
        <Protected
          kind="email"
          text={t('cta.write')}
          class="mt-4 inline-flex min-h-16 items-center bg-red px-8 font-display text-xl font-bold tracking-[0.08em] text-ink uppercase transition-colors hover:bg-ink hover:text-paper md:text-2xl"
        />
        <p class="mt-4 font-display text-[clamp(1.25rem,1rem+1.5vw,2rem)] font-bold break-words">
          <Protected kind="email" class="hover:text-red-text" />
          <NoJsContact class="hover:text-red-text" />
        </p>

        <div class="mt-12 border-t border-line pt-8">
          <p class="eyebrow text-muted">{t('contact.phone')}</p>
          <RevealPhone
            lang={lang}
            class="mt-4"
            buttonClass={secondary}
            numberClass="font-display text-[clamp(1.25rem,1rem+1.5vw,2rem)] font-bold hover:text-red-text"
            chipClass={secondary}
          />
        </div>

        <div class="mt-10 border-t border-line pt-8">
          <p class="eyebrow text-muted">{t('contact.messengers')}</p>
          <div class="mt-4 flex flex-wrap gap-3">
            <a href={contacts.telegram} rel="noopener" class={secondary}>Telegram</a>
            <a href={contacts.instagram} rel="noopener" class={secondary}>Instagram</a>
          </div>
        </div>
      </div>

      <address class="not-italic lg:col-span-4 lg:col-start-9">
        <div class="bg-ink p-8 text-paper md:p-10">
          <p class="eyebrow text-paper/70">{t('contact.address')}</p>
          <p class="mt-4 font-display text-2xl leading-snug font-bold uppercase">
            {[...contacts.addressLines, t('country.croatia')].map((line) => <span class="block">{line}</span>)}
          </p>
          <hr class="my-8 border-paper/20" />
          <p class="text-sm text-paper/80">
            {t('site.byline')}<br />
            {contacts.company}<br />
            {t('footer.oib')}: {contacts.oib}
          </p>
        </div>
      </address>
    </div>
  </section>
</Base>
