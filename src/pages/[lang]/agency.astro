---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import CtaBand from '../../components/CtaBand.astro';
import Numbers from '../../components/Numbers.astro';
import { published, useTranslations, type Lang } from '../../i18n/ui';
import { getCopy } from '../../i18n/copy';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const c = getCopy(lang).agency;
---

<Base lang={lang} title={`${c.title} — Urban Factory`} description={t('agency.meta.description')}>
  <PageHeader title={t('home.hero.title')} eyebrow={c.title} lead={c.lead} />

  <!-- История -->
  <section class="wrap pb-section" aria-labelledby="history-title">
    <h2 id="history-title" class="eyebrow text-muted">{t('agency.history')}</h2>
    <ol class="mt-8 border-t border-line">
      {
        c.history.map((h) => (
          <li class="reveal grid gap-3 border-b border-line py-8 md:grid-cols-12 md:gap-8 md:py-10">
            <span class="font-display text-3xl font-bold text-red md:col-span-3 md:text-4xl">{h.year}</span>
            <h3 class="text-2xl md:col-span-4 md:text-3xl">{h.title}</h3>
            <p class="text-ink/85 md:col-span-5">{h.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Подход -->
  <section class="bg-surface py-section" aria-labelledby="approach-title">
    <div class="wrap">
      <p class="eyebrow text-muted">{t('agency.approach')}</p>
      <h2 id="approach-title" class="mt-4 text-h2">{t('home.approach.title')}</h2>
      <ol class="mt-12 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-5">
        {
          c.approach.map((a, i) => (
            <li class="reveal bg-surface p-6 lg:p-8">
              <span class="font-display text-lg font-bold text-red">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 text-2xl">{a.title}</h3>
              <p class="mt-3 text-ink/85">{a.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Принципы -->
  <section class="wrap py-section" aria-labelledby="principles-title">
    <h2 id="principles-title" class="eyebrow text-muted">{t('agency.principles')}</h2>
    <ul class="mt-8 grid gap-x-12 gap-y-12 md:grid-cols-2">
      {
        c.principles.map((p) => (
          <li class="reveal border-t-4 border-ink pt-6">
            <h3 class="text-3xl">{p.title}</h3>
            <p class="mt-4 max-w-prose text-lead text-ink/85">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <Numbers lang={lang} />
  <CtaBand lang={lang} />
</Base>
