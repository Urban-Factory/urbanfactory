---
import { Image, Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Numbers from '../../components/Numbers.astro';
import Protected from '../../components/Protected.astro';
import CtaBand from '../../components/CtaBand.astro';
import { published, useTranslations, type Lang } from '../../i18n/ui';
import { getCopy } from '../../i18n/copy';
import { localePath, url } from '../../lib/site';
import { getProjects } from '../../lib/projects';
import { docFile } from '../../lib/docs';
import hero from '../../assets/home/hero-festival.jpg';
import portrait from '../../assets/team/mihail-veklenko.png';

export function getStaticPaths() {
  return published.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

// Сначала самое свежее (правило сайта, см. lib/projects.ts)
const featured = (await getProjects(lang)).filter((p) => p.data.featured).slice(0, 6);
// Чередуем ширину карточек: 7/5, 5/7, 7/5
const spans = ['lg:col-span-7', 'lg:col-span-5', 'lg:col-span-5', 'lg:col-span-7', 'lg:col-span-7', 'lg:col-span-5'];

const directions = [
  { id: 'engagement', color: 'bg-red', text: 'text-red-text', n: '01' },
  { id: 'strategy', color: 'bg-blue', text: 'text-blue-text', n: '02' },
  { id: 'design', color: 'bg-wheat', text: 'text-wheat-text', n: '03' },
] as const;

const publicItems = ['home.public.item1', 'home.public.item2', 'home.public.item3', 'home.public.item4', 'home.public.item5'] as const;

// Главная = страница агентства: подход, принципы и история — из copy.agency, основатель — из copy.team
const copy = getCopy(lang);
const a = copy.agency;
const team = copy.team;
const f = team.founder;
// CV основателя (public/docs): кнопка только если файл есть; в RU — русский файл, пока его нет — английский
const cv = docFile('cv-veklenko', lang);

// Города — от самой свежей активности к более ранней; под городом — страна
const places = [
  { city: 'city.yerevan', country: 'country.armenia' },
  { city: 'city.zagreb', country: 'country.croatia' },
  { city: 'city.rostov', country: 'country.russia' },
  { city: 'city.zverevo', country: 'country.russia' },
  { city: 'city.moscow', country: 'country.russia' },
  { city: 'city.recife', country: 'country.brazil' },
] as const;
---

<Base lang={lang} description={t('home.meta.description')}>
  <!-- Первый экран -->
  <section class="wrap pt-12 pb-10 md:pt-20 md:pb-16">
    <p class="eyebrow text-red-text">{t('home.hero.eyebrow')}</p>
    <h1 class="mt-5 max-w-[14ch] text-display">
      {t('home.hero.title')}<span class="text-red-text">.</span>
    </h1>
    <div class="mt-8 grid gap-8 md:mt-12 md:grid-cols-12 md:items-end">
      <p class="max-w-2xl text-lead text-ink/85 md:col-span-7">{t('home.hero.lead')}</p>
      <div class="flex flex-wrap gap-3 md:col-span-5 md:justify-end">
        <a href={localePath(lang, '/projects/')} class="inline-flex min-h-12 items-center bg-ink px-6 font-display font-semibold tracking-[0.08em] text-paper uppercase transition-colors hover:bg-red hover:text-ink">
          {t('home.hero.cta')}
        </a>
        <Protected
          kind="email"
          text={t('cta.write')}
          class="inline-flex min-h-12 items-center border-2 border-ink px-6 font-display font-semibold tracking-[0.08em] uppercase transition-colors hover:bg-ink hover:text-paper"
        />
      </div>
    </div>
  </section>

  <div class="wrap">
    <div class="relative">
      <Image
        src={hero}
        alt={t('home.hero.imageAlt')}
        widths={[480, 800, 1200, 1600, 2224]}
        sizes="(min-width: 1440px) 1344px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full object-cover md:aspect-[21/9]"
      />
      <!-- Вертикальная плашка из фирстиля -->
      <div class="absolute top-0 right-6 hidden h-full w-[clamp(5rem,9vw,8.5rem)] flex-col items-center justify-between bg-red py-8 text-ink md:flex" aria-hidden="true">
        <Logo variant="mark" class="h-[clamp(4rem,8vw,7rem)]" />
        <span class="font-display text-sm font-bold tracking-[0.3em] uppercase [writing-mode:vertical-rl] rotate-180">Urban Factory</span>
      </div>
    </div>
  </div>

  <!-- Три направления -->
  <section class="wrap py-section" aria-labelledby="directions-title">
    <div class="reveal max-w-3xl">
      <p class="eyebrow text-muted">{t('home.directions.eyebrow')}</p>
      <h2 id="directions-title" class="mt-4 text-h2">{t('home.directions.title')}</h2>
    </div>
    <ul class="mt-12 grid gap-px bg-line md:mt-16 md:grid-cols-3">
      {
        directions.map((d) => (
          <li class="reveal flex flex-col bg-paper pt-0 pb-10 md:px-8 md:first:pl-0 md:last:pr-0">
            <span class:list={['block h-1.5 w-full', d.color]} aria-hidden="true" />
            <span class:list={['mt-6 font-display text-lg font-bold', d.text]}>{d.n}</span>
            <h3 class="mt-2 text-3xl leading-none">{t(`cat.${d.id}`)}</h3>
            <p class="mt-5 flex-1 text-ink/85">{t(`home.dir.${d.id}.text`)}</p>
            <a href={localePath(lang, `/services/#${d.id}`)} class="link-arrow mt-8 text-sm">
              {t('home.dir.more')}<span class="sr-only">: {t(`cat.${d.id}`)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Для городов и муниципалитетов -->
  <section class="wrap pb-section" aria-labelledby="public-title">
    <div class="grid gap-10 border-t border-line pt-12 md:pt-16 lg:grid-cols-12">
      <div class="reveal lg:col-span-5">
        <p class="eyebrow text-muted">{t('home.public.eyebrow')}</p>
        <h2 id="public-title" class="mt-4 text-h2">{t('home.public.title')}</h2>
        <p class="mt-6 max-w-prose text-lead text-ink/85">{t('home.public.lead')}</p>
        <a href={localePath(lang, '/projects/#public-sector')} class="link-arrow mt-8">{t('home.public.link')}</a>
      </div>
      <ul class="reveal space-y-3 self-end lg:col-span-6 lg:col-start-7">
        {
          publicItems.map((key) => (
            <li class="flex gap-3 border-b border-line pb-3">
              <span class="mt-2.5 h-2 w-2 shrink-0 bg-blue" aria-hidden="true" />
              <span>{t(key)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Избранные проекты -->
  <section class="bg-surface py-section" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="reveal flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow text-muted">{t('home.featured.eyebrow')}</p>
          <h2 id="featured-title" class="mt-4 text-h1">{t('home.featured.title')}</h2>
        </div>
        <a href={localePath(lang, '/projects/')} class="link-arrow">{t('home.featured.all')}</a>
      </div>
      <div class="mt-12 grid gap-x-8 gap-y-16 md:mt-16 md:grid-cols-2 lg:grid-cols-12">
        {
          featured.map((p, i) => (
            <div class:list={['reveal', spans[i]]}>
              <ProjectCard project={p} lang={lang} size={spans[i] === 'lg:col-span-7' ? 'large' : 'default'} />
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Подход: вводный абзац агентства и 5 шагов -->
  <section class="wrap py-section" aria-labelledby="approach-title">
    <div class="reveal max-w-3xl">
      <p class="eyebrow text-muted">{t('home.approach.eyebrow')}</p>
      <h2 id="approach-title" class="mt-4 text-h2">{t('home.approach.title')}</h2>
      <p class="mt-6 text-lead text-ink/85">{a.lead}</p>
      <p class="mt-4 text-ink/85">{t('home.approach.text')}</p>
    </div>
    <ol class="mt-12 grid gap-px bg-line sm:grid-cols-2 lg:grid-cols-5">
      {
        a.approach.map((s, i) => (
          <li class="reveal bg-paper p-6 lg:p-8">
            <span class="font-display text-lg font-bold text-red-text">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-2xl">{s.title}</h3>
            <p class="mt-3 text-ink/85">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Принципы -->
  <section class="wrap pb-section" aria-labelledby="principles-title">
    <h2 id="principles-title" class="eyebrow text-muted">{t('agency.principles')}</h2>
    <ul class="mt-8 grid gap-x-12 gap-y-12 md:grid-cols-2">
      {
        a.principles.map((p) => (
          <li class="reveal border-t-4 border-ink pt-6">
            <h3 class="text-3xl">{p.title}</h3>
            <p class="mt-4 max-w-prose text-lead text-ink/85">{p.text}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Основатель -->
  <section id="osnivac" class="scroll-mt-24 bg-surface py-section" aria-labelledby="founder-title">
    <div class="wrap">
      <article class="grid gap-10 md:grid-cols-12 md:gap-12">
        <div class="self-start md:sticky md:top-28 md:col-span-5 lg:col-span-4">
          <!-- Фото с прозрачным фоном; фон — токен paper -->
          <Picture
            src={portrait}
            alt={`${t('team.photo')} ${f.name}`}
            formats={['avif', 'webp']}
            widths={[320, 480, 640, 960, 1200]}
            sizes="(min-width: 1024px) 30vw, (min-width: 768px) 40vw, 100vw"
            class="aspect-square w-full bg-paper object-cover"
          />
        </div>
        <div class="md:col-span-7 lg:col-span-7 lg:col-start-6">
          <p class="eyebrow text-red-text">{f.role}</p>
          <h2 id="founder-title" class="mt-3 text-h1">{f.name}</h2>
          <div class="mt-8 space-y-4 text-lead text-ink/85">
            {f.bio.map((p) => <p>{p}</p>)}
          </div>

          <p class="mt-10 border-l-4 border-red pl-4 font-display text-xl font-semibold">{f.summary}</p>

          <h3 class="mt-12 eyebrow text-muted">{t('team.expertise')}</h3>
          <ul class="mt-5 space-y-3">
            {
              f.expertise.map((e) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 h-2 w-2 shrink-0 bg-red" aria-hidden="true" />
                  <span>{e}</span>
                </li>
              ))
            }
          </ul>

          {
            cv && (
              <a
                href={url(`/docs/${cv}`)}
                type="application/pdf"
                class="mt-10 inline-flex min-h-12 items-center border-2 border-ink px-6 font-display font-semibold tracking-[0.08em] uppercase transition-colors hover:bg-ink hover:text-paper"
              >
                {t('home.founder.cv')}
              </a>
            )
          }

          <!-- Партнёрская сеть -->
          <div class="mt-12 border-t border-line pt-8">
            <h3 class="eyebrow text-muted">{team.partners.title}</h3>
            <p class="mt-4 max-w-prose text-lead text-ink/85">{team.partners.text}</p>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- История -->
  <section class="wrap py-section" aria-labelledby="history-title">
    <h2 id="history-title" class="eyebrow text-muted">{t('agency.history')}</h2>
    <ol class="mt-8 border-t border-line">
      {
        a.history.map((h) => (
          <li class="reveal grid gap-3 border-b border-line py-8 md:grid-cols-12 md:gap-8 md:py-10">
            <span class="font-display text-3xl font-bold text-red-text md:col-span-3 md:text-4xl">{h.year}</span>
            <h3 class="text-2xl md:col-span-4 md:text-3xl">{h.title}</h3>
            <p class="text-ink/85 md:col-span-5">{h.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <Numbers lang={lang} />

  <!-- География -->
  <section class="wrap py-section" aria-labelledby="geo-title">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="reveal lg:col-span-5">
        <p class="eyebrow text-muted">{t('home.geo.eyebrow')}</p>
        <h2 id="geo-title" class="mt-4 text-h2">{t('home.geo.title')}</h2>
        <p class="mt-6 max-w-prose text-ink/85">{t('home.geo.text')}</p>
      </div>
      <ul class="reveal grid grid-cols-2 gap-px self-end bg-line sm:grid-cols-3 lg:col-span-6 lg:col-start-7">
        {
          places.map((p) => (
            <li class="bg-paper p-5">
              <span class="block font-display text-lg font-bold uppercase sm:text-xl md:text-2xl">{t(p.city)}</span>
              <span class="mt-1 block text-sm text-muted">{t(p.country)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>
