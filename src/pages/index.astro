---
// Корень сайта → основной язык /hr/ (GitHub Pages не умеет серверных редиректов)
import { defaultLang } from '../i18n/ui';
import { localePath } from '../lib/site';
const target = localePath(defaultLang, '/');
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <title>Urban Factory</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site).href} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <a href={target}>Urban Factory</a>
  </body>
</html>
