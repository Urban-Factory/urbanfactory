---
/**
 * 404 для GitHub Pages: одна страница на три языка (Pages отдаёт /404.html на любой несуществующий адрес).
 * Язык берётся из адреса скриптом; без JS видны все три варианта.
 */
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Footer from '../components/Footer.astro';
import { defaultLang, languages, published, useTranslations } from '../i18n/ui';
import { localePath, url } from '../lib/site';
---

<!doctype html>
<html lang={languages[defaultLang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Urban Factory</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="flex min-h-dvh flex-col bg-paper text-ink">
    <header class="border-b border-line">
      <div class="wrap flex h-16 items-center md:h-20">
        <a href={localePath(defaultLang, '/')} aria-label="Urban Factory" class="h-9 md:h-11"><Logo class="h-full" /></a>
      </div>
    </header>
    <main class="wrap flex-1 py-section">
      <p class="font-display text-[clamp(5rem,3rem+10vw,12rem)] leading-none font-bold text-red-text">404</p>
      <div class="mt-10 grid gap-12 md:grid-cols-3">
        {
          published.map((lang) => {
            const t = useTranslations(lang);
            return (
              <section lang={languages[lang].htmlLang} data-404={lang}>
                <h1 class="text-2xl md:text-3xl">{t('notFound.title')}</h1>
                <p class="mt-3 text-ink/85">{t('notFound.text')}</p>
                <ul class="mt-6 space-y-2">
                  <li><a href={localePath(lang, '/')} class="link-arrow text-sm">{t('notFound.home')}</a></li>
                  <li><a href={localePath(lang, '/projects/')} class="link-arrow text-sm">{t('nav.projects')}</a></li>
                  <li><a href={localePath(lang, '/contact/')} class="link-arrow text-sm">{t('nav.contact')}</a></li>
                </ul>
              </section>
            );
          })
        }
      </div>
    </main>
    <!-- Подвал основного языка: юрлицо, контакты, меню -->
    <Footer lang={defaultLang} />
    <script>
      // Показать на первом месте язык из адреса (/hr/…, /ru/…)
      const m = location.pathname.match(/\/(en|hr|ru)(\/|$)/);
      if (m) {
        const el = document.querySelector<HTMLElement>(`[data-404="${m[1]}"]`);
        el?.parentElement?.prepend(el);
        document.documentElement.lang = m[1];
      }
    </script>
  </body>
</html>
