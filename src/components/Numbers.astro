---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Только подтверждённые цифры (спорные — см. PROGRESS.md, ждут решения)
const numbers = [
  { value: '2013', key: 'home.num.founded' },
  { value: '13', key: 'home.num.projects' },
  { value: '3.1', key: 'home.num.area' },
  { value: '119', key: 'home.num.tram' },
] as const;
---

<section class="bg-ink py-section text-paper" aria-labelledby="numbers-title">
  <div class="wrap">
    <h2 id="numbers-title" class="eyebrow text-paper/70">{t('home.numbers.eyebrow')}</h2>
    <dl class="mt-12 grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {
        numbers.map((n) => (
          <div class="reveal flex flex-col-reverse justify-end border-t border-paper/25 pt-6">
            <dt class="mt-4 max-w-[22ch] text-paper/80">{t(n.key)}</dt>
            <dd class="font-display text-[clamp(3.5rem,2rem+5vw,6.5rem)] leading-none font-bold">{n.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
