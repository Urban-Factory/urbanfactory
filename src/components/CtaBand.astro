---
import Protected from './Protected.astro';
import NoJsContact from './NoJsContact.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-red text-paper">
  <div class="wrap flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between md:py-24">
    <div class="max-w-3xl">
      <h2 class="text-h2">{t('home.cta.title')}</h2>
      <p class="mt-4 text-lead text-paper/90">{t('home.cta.text')}</p>
    </div>
    <div class="flex shrink-0 flex-col items-start gap-4 md:items-end">
      <Protected
        kind="email"
        text={t('cta.write')}
        class="inline-flex min-h-14 items-center bg-paper px-8 font-display text-lg font-bold tracking-[0.08em] text-ink uppercase transition-colors hover:bg-ink hover:text-paper"
      />
      <NoJsContact class="font-display text-lg font-bold underline underline-offset-4" />
      <a href={localePath(lang, '/contact/')} class="link-arrow text-sm text-paper/90 hover:text-paper">{t('cta.other')}</a>
    </div>
  </div>
</section>
