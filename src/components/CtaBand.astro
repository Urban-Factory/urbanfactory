---
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="bg-red text-paper">
  <div class="wrap flex flex-col gap-8 py-16 md:flex-row md:items-end md:justify-between md:py-24">
    <div class="max-w-3xl">
      <h2 class="text-h2">{t('home.cta.title')}</h2>
      <p class="mt-4 text-lead text-paper/90">{t('home.cta.text')}</p>
    </div>
    <a href={localePath(lang, '/contact/')} class="inline-flex min-h-12 shrink-0 items-center self-start bg-paper px-7 font-display font-semibold tracking-[0.08em] text-ink uppercase transition-colors hover:bg-ink hover:text-paper md:self-auto">
      {t('home.cta.button')}
    </a>
  </div>
</section>
