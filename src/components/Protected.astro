---
/**
 * Ссылка на email, которую собирает JS на клиенте.
 * В HTML адреса нет. Без JS элемент скрыт — рядом нужен <NoJsContact />.
 * Телефон — отдельно, только по кнопке: <RevealPhone />.
 *   kind  — email
 *   text  — видимая подпись; если не задана, показывается сам адрес
 */
interface Props {
  kind: 'email';
  text?: string;
  class?: string;
}
const { kind, text, class: cls } = Astro.props;
---

<a hidden data-protected={kind} data-show-value={text ? undefined : ''} class={cls}><slot />{text}</a>

<script>
  import { protectedContacts as c } from '../lib/site';

  const decode = (parts: readonly string[]) => [...atob(parts.join(''))].reverse().join('');

  document.querySelectorAll<HTMLAnchorElement>('a[data-protected]').forEach((a) => {
    const kind = a.dataset.protected;
    let href = '';
    let value = '';
    if (kind === 'email') {
      value = decode(c.email);
      href = `mailto:${value}`;
    }
    a.href = href;
    if (a.hasAttribute('data-show-value')) a.append(value);
    a.hidden = false;
  });
</script>
