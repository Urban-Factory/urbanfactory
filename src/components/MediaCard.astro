---
/**
 * Крупная карточка записи на странице Media: интервью с полным текстом, видео или внешняя публикация.
 * Используется в закреплённом блоке (поле pin) и в разделе «Интервью».
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';
import LiteYouTube from './LiteYouTube.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../lib/site';

export interface CardData {
  title: string;
  summary?: string;
  meta: string;
  cover?: ImageMetadata;
  coverAlt: string;
  href?: string;
  internal: boolean;
  video?: string;
}

interface Props {
  entry: CollectionEntry<'media'>;
  card: CardData;
  lang: Lang;
  eager?: boolean;
  large?: boolean; // во всю ширину: видео 16:9 и крупный заголовок
}
const { entry: e, card: c, lang, eager = false, large = false } = Astro.props;
const t = useTranslations(lang);
const media = large ? '[&_a]:aspect-video' : '[&_a]:aspect-[4/3]';
---

<article class="group relative flex h-full flex-col">
  {
    c.video ? (
      <LiteYouTube id={c.video} title={c.title} lang={lang} videoLang={e.data.originalLang === 'pt' ? undefined : e.data.originalLang} class={`relative z-10 ${media} [&_figcaption]:hidden`} />
    ) : (
      <div class:list={['overflow-hidden bg-surface', large ? 'aspect-video' : 'aspect-[4/3]']}>
        {c.cover ? (
          <Image
            src={c.cover}
            alt={c.coverAlt}
            widths={[480, 800, 1200]}
            sizes={large ? '(min-width: 1440px) 1344px, 100vw' : '(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw'}
            loading={eager ? 'eager' : 'lazy'}
            class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
          />
        ) : (
          <div class="flex h-full items-center justify-center text-ink/10">
            <Logo variant="mark" class="h-1/2" />
          </div>
        )}
      </div>
    )
  }
  <p class="mt-5 eyebrow text-red-text">{c.meta}</p>
  <h3 class:list={['mt-3 leading-[1.05]', large ? 'text-3xl md:text-5xl' : 'text-2xl md:text-3xl']}>
    {
      c.href ? (
        <a href={c.href} target={c.internal ? undefined : '_blank'} rel={c.internal ? undefined : 'noopener'} class="after:absolute after:inset-0 after:content-['']">
          {c.title}
          {!c.internal && <span class="sr-only"> ({t('media.newWindow')})</span>}
        </a>
      ) : (
        c.title
      )
    }
  </h3>
  {c.summary && <p class="mt-3 max-w-prose text-ink/85">{c.summary}</p>}
  <p class="mt-4 text-sm text-ink/80">
    {e.data.outlet}
    <span class="mx-2 inline-block border border-ink/30 px-1.5 text-xs leading-5 font-semibold">{t(`media.lang.${e.data.originalLang}`)}</span>
    {e.data.role}
    {c.video && e.data.originalLang !== lang && e.data.originalLang !== 'pt' && <span class="font-semibold"> · {t(`video.in.${e.data.originalLang}`)}</span>}
  </p>
  <div class="relative z-10 mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-5 text-sm">
    {c.internal && <span class="link-arrow" aria-hidden="true">{t('media.read')}</span>}
    {c.video && <span class="link-arrow" aria-hidden="true">{t('media.watch')}</span>}
    {
      e.data.url && (
        <a href={e.data.url} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-red-text">
          {e.data.urlLabel ?? t('media.original')} ↗<span class="sr-only"> ({t('media.newWindow')})</span>
        </a>
      )
    }
    {
      e.data.archive && (
        <a href={e.data.archive} target="_blank" rel="noopener" class="underline underline-offset-4 hover:text-red-text">
          {t('media.archive')} ↗<span class="sr-only"> ({t('media.newWindow')})</span>
        </a>
      )
    }
  </div>
  {
    e.data.seeAlso && (
      <a href={localePath(lang, `/projects/${e.data.seeAlso.project}/`)} class="link-arrow relative z-10 mt-3 text-sm font-bold text-red-text">
        {e.data.seeAlso.label}
      </a>
    )
  }
</article>
