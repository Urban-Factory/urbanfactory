---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';
import CategoryTag from './CategoryTag.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { localePath } from '../lib/site';
import { formatYears } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
  lang: Lang;
  size?: 'large' | 'default';
  eager?: boolean;
}
const { project, lang, size = 'default', eager = false } = Astro.props;
const t = useTranslations(lang);
const p = project.data;
const href = localePath(lang, `/projects/${p.slug}/`);
const widths = size === 'large' ? [480, 800, 1200, 1600] : [400, 640, 960];
const sizes = size === 'large' ? '(min-width: 1024px) 58vw, 100vw' : '(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw';
---

<article class="group relative flex flex-col">
  <div class:list={['relative overflow-hidden bg-surface', size === 'large' ? 'aspect-[4/3] lg:aspect-[16/11]' : 'aspect-[4/3]']}>
    {
      p.cover ? (
        <Image
          src={p.cover}
          alt={p.coverAlt ?? ''}
          widths={widths}
          sizes={sizes}
          loading={eager ? 'eager' : 'lazy'}
          class={`h-full w-full transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none ${p.coverFit === 'contain' ? 'bg-paper object-contain p-[8%]' : 'object-cover'}`}
        />
      ) : (
        <div class="flex h-full items-center justify-center text-ink/10">
          <Logo variant="mark" class="h-1/2" />
        </div>
      )
    }
  </div>
  <div class="mt-5 flex flex-wrap gap-2">
    {p.category.map((c) => <CategoryTag category={c} lang={lang} />)}
  </div>
  <h3 class:list={['mt-3 leading-[1.05]', size === 'large' ? 'text-3xl md:text-4xl' : 'text-2xl']}>
    <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none group-has-[a:focus-visible]:underline">
      {p.title}
    </a>
  </h3>
  <p class="mt-2 text-sm text-muted">{p.city} · {formatYears(p.year, t('project.present'))}</p>
  <p class="mt-3 max-w-prose text-ink/85">{p.summary}</p>
  <span class="sr-only">{t('home.featured.title')}</span>
</article>
