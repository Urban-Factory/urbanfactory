---
import Logo from './Logo.astro';
import Protected from './Protected.astro';
import NoJsContact from './NoJsContact.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { contacts, localePath } from '../lib/site';
import { mainNav } from '../lib/nav';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
  <div class="wrap grid gap-12 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-5">
      <a href={localePath(lang, '/')} aria-label={t('a11y.home')} class="inline-block h-12 text-paper">
        <Logo class="h-full" />
      </a>
      <p class="mt-6 max-w-sm font-display text-xl font-semibold tracking-wide uppercase">{t('home.hero.title')}</p>
    </div>

    <nav class="md:col-span-3" aria-label={t('a11y.footerNav')}>
      <ul class="space-y-3">
        {
          mainNav.map((item) => (
            <li>
              <a href={localePath(lang, item.href)} class="font-display font-semibold tracking-[0.08em] uppercase hover:text-paper/70">
                {t(item.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="md:col-span-4">
      <p class="eyebrow text-paper/70">{t('footer.write')}</p>
      <Protected
        kind="email"
        text={t('cta.write')}
        class="mt-4 inline-flex min-h-12 items-center bg-red px-6 font-display font-bold tracking-[0.08em] text-ink uppercase transition-colors hover:bg-paper hover:text-ink"
      />
      <p class="mt-3 text-paper/80"><Protected kind="email" class="underline-offset-4 hover:underline" /></p>
      <NoJsContact class="underline underline-offset-4" />
      <p class="mt-4"><Protected kind="phone" class="underline-offset-4 hover:underline" /></p>
      <ul class="mt-5 flex flex-wrap gap-2 text-sm">
        <li><Protected kind="whatsapp" text="WhatsApp" class="inline-flex min-h-10 items-center border border-paper/40 px-3 hover:border-paper" /></li>
        <li><a href={contacts.telegram} rel="noopener" class="inline-flex min-h-10 items-center border border-paper/40 px-3 hover:border-paper">Telegram</a></li>
        <li><a href={contacts.instagram} rel="noopener" class="inline-flex min-h-10 items-center border border-paper/40 px-3 hover:border-paper">Instagram</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-paper/15">
    <p class="wrap flex flex-col gap-1 py-6 text-sm text-paper/70 md:flex-row md:flex-wrap md:gap-x-3">
      <span class="text-paper">{t('site.byline')}</span>
      <span aria-hidden="true" class="hidden md:inline">·</span>
      <span>{contacts.company}</span>
      <span aria-hidden="true" class="hidden md:inline">·</span>
      <span>{contacts.addressLines.join(', ')}, {t('country.croatia')}</span>
      <span aria-hidden="true" class="hidden md:inline">·</span>
      <span>{t('footer.oib')}: {contacts.oib}</span>
      <span aria-hidden="true" class="hidden md:inline">·</span>
      <span>© {year}</span>
    </p>
  </div>
</footer>
